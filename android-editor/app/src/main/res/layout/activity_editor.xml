<?xml version="1.0" encoding="utf-8"?>
<com.microui.zigeditor.DrawerRootLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 编辑区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/palette_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/drawer_toggle"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="文件列表"
                android:text="☰"
                android:textColor="?attr/palette_on_surface_variant"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/file_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/palette_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_undo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/m3_run_button"
                android:contentDescription="撤销"
                android:padding="12dp"
                android:src="@drawable/ic_undo"
                android:tint="?attr/palette_on_primary_container" />

            <ImageButton
                android:id="@+id/btn_redo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/m3_run_button"
                android:contentDescription="重做"
                android:padding="12dp"
                android:src="@drawable/ic_redo"
                android:tint="?attr/palette_on_primary_container" />

            <Button
                android:id="@+id/btn_run"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/m3_run_button"
                android:contentDescription="运行"
                android:text="▶"
                android:textColor="?attr/palette_on_primary_container"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_run_menu"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:contentDescription="运行参数"
                android:text="⋮"
                android:textColor="?attr/palette_on_surface_variant"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- 顶栏与编辑区之间的浅分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/palette_outline_variant" />

        <io.github.rosemoe.sora.widget.CodeEditor
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 字符键区上方的浅分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/palette_outline_variant" />

        <!-- 字符快捷键区：默认一行，按住往上拖逐行展开 -->
        <com.microui.zigeditor.CharKeyBar
            android:id="@+id/char_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- 点击遮罩关闭侧滑栏 -->
    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- 侧滑栏：项目信息 + 操作按钮 + 文件树 + 夜间模式开关 -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/palette_surface_container"
        android:orientation="vertical">

        <!-- 项目名 + 路径 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/project_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/palette_on_surface"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/project_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="?attr/palette_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 操作按钮：圆形 tonal 图标按钮（新建 / 终端 / Api；原生项目额外显示「编译 so」） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/new_zig_file"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/m3_icon_button_tonal"
                android:contentDescription="新建文件或文件夹"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:src="@drawable/ic_add"
                android:tint="?attr/palette_on_secondary_container" />

            <!-- 终端入口：进入本项目的终端（自动 cd 到项目目录） -->
            <ImageButton
                android:id="@+id/open_terminal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/m3_icon_button_tonal"
                android:contentDescription="终端"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:src="@drawable/ic_terminal"
                android:tint="?attr/palette_on_secondary_container" />

            <ImageButton
                android:id="@+id/api_docs"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/m3_icon_button_tonal"
                android:contentDescription="文档"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:src="@drawable/ic_book"
                android:tint="?attr/palette_on_secondary_container" />

            <!-- 仅原生 zig 项目显示：编译 .so 并默认导出到系统下载目录 -->
            <ImageButton
                android:id="@+id/native_so_build"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/m3_icon_button_tonal"
                android:contentDescription="编译 so 并导出到下载"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:src="@drawable/ic_so"
                android:tint="?attr/palette_on_secondary_container"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:paddingStart="20dp"
            android:paddingTop="2dp"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp"
            android:text="项目文件"
            android:textColor="?attr/palette_on_surface_variant"
            android:textSize="11sp" />

        <ListView
            android:id="@+id/file_tree"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/palette_surface_container"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- 底部：夜间模式开关（默认白天） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/palette_outline_variant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="夜间模式"
                android:textColor="?attr/palette_on_surface"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/night_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>

</com.microui.zigeditor.DrawerRootLayout>
