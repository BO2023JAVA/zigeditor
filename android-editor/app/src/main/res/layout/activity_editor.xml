<?xml version="1.0" encoding="utf-8"?>
<com.microui.zigeditor.DrawerRootLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 编辑区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/m3_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/drawer_toggle"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="文件列表"
                android:text="☰"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/file_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/m3_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_undo"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="撤销"
                android:text="↶"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btn_redo"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="重做"
                android:text="↷"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btn_run"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/m3_run_button"
                android:contentDescription="运行"
                android:text="▶"
                android:textColor="@color/m3_on_primary_container"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_run_menu"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:contentDescription="运行参数"
                android:text="⋮"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="20sp" />

        </LinearLayout>

        <io.github.rosemoe.sora.widget.CodeEditor
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- 点击遮罩关闭侧滑栏 -->
    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- 侧滑栏：VSCode 风格文件树 -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/m3_surface_container"
        android:orientation="vertical">

        <!-- 项目名 + 完整路径 -->
        <TextView
            android:id="@+id/project_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 功能按钮横排，节省竖向空间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/new_zig_file"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="新建"
                android:textAllCaps="false"
                android:textColor="@color/m3_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/compile_terminal"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="编译"
                android:textAllCaps="false"
                android:textColor="@color/m3_primary"
                android:textSize="13sp" />

            <!-- 终端入口：进入本项目的终端（自动 cd 到项目目录） -->
            <Button
                android:id="@+id/open_terminal"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="终端"
                android:textAllCaps="false"
                android:textColor="@color/m3_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/api_docs"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="Api"
                android:textAllCaps="false"
                android:textColor="@color/m3_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <ListView
            android:id="@+id/file_tree"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/m3_surface_container"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

    </LinearLayout>

</com.microui.zigeditor.DrawerRootLayout>
