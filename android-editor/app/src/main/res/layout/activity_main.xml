<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/palette_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ZigEditor"
            android:textColor="?attr/palette_on_surface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/import_project"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/m3_icon_button_tonal"
            android:contentDescription="导入项目"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_import_project"
            android:tint="?attr/palette_on_secondary_container" />

        <ImageButton
            android:id="@+id/open_packages"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/m3_run_button"
            android:contentDescription="包管理"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_build_wrench"
            android:tint="?attr/palette_on_primary_container" />
    </LinearLayout>

    <TextView
        android:id="@+id/proj_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="?attr/palette_on_surface_variant"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/file_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="8dp" />

        <ProgressBar
            android:id="@+id/proj_loading"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/new_project"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/m3_button_filled"
        android:foreground="?android:attr/selectableItemBackground"
        android:minHeight="52dp"
        android:stateListAnimator="@null"
        android:text="新建项目"
        android:textAllCaps="false"
        android:textColor="?attr/palette_on_primary"
        android:textSize="16sp" />

</LinearLayout>
