<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/m3_surface">

    <TextView
        android:id="@+id/terminal_env"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textColor="@color/m3_primary"
        android:textSize="12sp"
        android:text="检查 proot / rootfs / zig ..." />

    <!-- 与 Xed-Editor 同类的 Termux 终端：真实 PTY、ANSI、光标、滚动和文本选择。 -->
    <com.termux.view.TerminalView
        android:id="@+id/terminal_screen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/m3_surface"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- 终端辅助键栏：Tab、方向键、Ctrl（对准输入行做编辑/历史翻找），最右是包管理 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/m3_surface_container"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_tab"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="Tab"
                android:textAllCaps="false"
                android:textColor="@color/m3_on_surface_variant" />

            <Button
                android:id="@+id/btn_up"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="↑"
                android:textColor="@color/m3_on_surface_variant" />

            <Button
                android:id="@+id/btn_down"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="↓"
                android:textColor="@color/m3_on_surface_variant" />

            <Button
                android:id="@+id/btn_left"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="←"
                android:textColor="@color/m3_on_surface_variant" />

            <Button
                android:id="@+id/btn_right"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="→"
                android:textColor="@color/m3_on_surface_variant" />

            <Button
                android:id="@+id/btn_ctrl"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="Ctrl"
                android:textAllCaps="false"
                android:textColor="@color/m3_primary" />

            <Button
                android:id="@+id/btn_pkgs"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:text="包管理"
                android:textAllCaps="false"
                android:textColor="@color/m3_primary" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
