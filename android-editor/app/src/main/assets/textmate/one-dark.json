{
  "name": "One Dark",
  "tokenColors": [
    {
      "settings": {
        "foreground": "#ABB2BF"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5C6370"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#C678DD"
      }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "#98C379"
      }
    },
    {
      "name": "String escape sequences",
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "name": "Numbers and characters",
      "scope": [
        "constant.numeric",
        "constant.character"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "Types",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type",
        "entity.name.namespace",
        "support.class",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#E5C07B"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#61AFEF"
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "support.constant",
        "variable.language",
        "keyword.constant"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "settings": {
        "foreground": "#ABB2BF"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "foreground": "#E06C75"
      }
    }
  ],
  "colors": {
    "focusBorder": "#528BFF",
    "selection.background": "#3E4451",
    "editor.background": "#282C34",
    "editor.foreground": "#ABB2BF",
    "editorCursor.foreground": "#528BFF",
    "editor.lineHighlightBackground": "#2C313C",
    "editor.selectionBackground": "#3E4451",
    "editorLineNumber.foreground": "#495162",
    "editorLineNumber.activeForeground": "#C6C6C6",
    "editorWhitespace.foreground": "#3B4048",
    "editorIndentGuide.background": "#3B4048",
    "editorIndentGuide.activeBackground": "#528BFF80"
  },
  "semanticHighlighting": true
}
